# =============================================================================
# Pulse — variáveis de ambiente
# Copie para .env.local e preencha. .env* está no .gitignore.
# =============================================================================

# --- Clerk -------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/entrar
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/cadastrar

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ignora RLS. Só em webhook e handler de job, nunca em código de página.
SUPABASE_SERVICE_ROLE_KEY=

# --- Criptografia das credenciais de gateway ---------------------------------
# 32 bytes em base64:  openssl rand -base64 32
# Perder esta chave torna ilegível toda credencial já gravada. Guarde fora do
# banco e fora do repositório.
APP_ENCRYPTION_KEY=

# --- Cron --------------------------------------------------------------------
# Protege /api/cron/*. O Vercel Cron envia no header x-cron-secret.
CRON_SECRET=

# --- Gateway (Asaas — primeiro adapter) --------------------------------------
# A chave de API de cada organização é gravada cifrada no banco, não aqui.
# Isto é só para o ambiente de desenvolvimento.
ASAAS_ENVIRONMENT=sandbox

# --- WhatsApp (Z-API — primeira implementação de MessagingProvider) ----------
# NOTA: Z-API é ponte não-oficial. O brand book (§3.1) classifica disparo sem
# opt-in registrado e bloqueio de número como risco existencial da operação.
# A aprovação de template Meta na categoria Utility precisa correr em paralelo
# desde já — o prazo é externo e não controlável.
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
